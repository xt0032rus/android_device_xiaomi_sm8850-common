allow tee mnt_vendor_file:file r_file_perms;

# qseecomd scans the GPT/XBL/boot LUNs to find its partitions
allow tee { vendor_gpt_block_device vendor_xbl_block_device boot_block_device }:blk_file r_file_perms;

type_transition tee vendor_persist_data_file:dir vendor_persist_data_file;

allow tee mitee_client_device:chr_file rw_file_perms;
allow tee mitee_data_file:dir create_dir_perms;
allow tee mitee_data_file:file create_file_perms;
allow tee mitee_sfs_file:dir create_dir_perms;
allow tee mitee_sfs_file:file create_file_perms;
allow tee proc_mitee_log:file { getattr open read };

get_prop(tee, vold_post_fs_data_prop)
get_prop(tee, vendor_mi_qvirtmgr_prop)
set_prop(tee, vendor_mitee_prop)

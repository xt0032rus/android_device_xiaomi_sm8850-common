soong_config_module_type {
    name: "xiaomi_parts_audio_defaults",
    module_type: "java_defaults",
    config_namespace: "xiaomi_parts",
    bool_variables: ["unified_audio"],
    properties: ["additional_manifests"],
}

xiaomi_parts_audio_defaults {
    name: "xiaomi_parts_audio_settings",
    soong_config_variables: {
        unified_audio: {
            additional_manifests: [],
            conditions_default: {
                additional_manifests: ["AndroidManifest.misound.xml"],
            },
        },
    },
}

android_app {
    name: "XiaomiParts",
    certificate: "platform",
    defaults: ["SettingsLibDefaults", "xiaomi_parts_audio_settings"],
    srcs: ["src/**/*.kt"],
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.appcompat_appcompat",
        "androidx.core_core",
        "androidx.preference_preference",
        "org.lineageos.settings.resources",
        "vendor.xiaomi.hw.touchfeature-V1-java",
    ],
}
